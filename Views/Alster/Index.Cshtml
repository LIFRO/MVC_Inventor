@model IEnumerable<Alster>

<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Tillbaka</a>
            <a class="navbar-brand" asp-area="" asp-controller="Alster" asp-action="Category" asp-route-categoryId="1">Träd kategori 1</a>
            <a class="navbar-brand" asp-area="" asp-controller="Alster" asp-action="Category" asp-route-categoryId="2">Träd kategori 2</a>
            <a class="navbar-brand" asp-area="" asp-controller="Alster" asp-action="Category" asp-route-categoryId="3">metall kategori 1</a>
            <a class="navbar-brand" asp-area="" asp-controller="Alster" asp-action="Category" asp-route-categoryId="4">metall kategori 2</a>
        </div>
    </nav>
</header>

<div class="text-center">
    <h1 class="display-4">Alster</h1>

    @if (Model == null || !Model.Any())
    {
        <p>Inga alster att visa.</p>
    }
    else
    {
        <div class="alster-grid">
            @foreach (var item in Model)
            {
                <div class="centered_image">
                    <div class="fw-semibold">@item.Name</div>
                    <div>@item.Description</div>
                    <div><img src="@Url.Content("~/" + item.Image)" alt="@item.Name" class="Alster_Size_Img"></div>
                </div>
            }
        </div>
    }
</div>
