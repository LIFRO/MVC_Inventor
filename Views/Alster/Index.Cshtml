@model IEnumerable<Alster>
@{
    ViewData["Title"] = "Tarkovasda Page";
}
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="" asp-action="Index">Tillbacks</a>
            </div>
        </nav>
    </header>

<div class="text-center">
    <h1 class="display-4">Alster</h1>

    @if (Model == null || !Model.Any())
    {
        <p>Inga alster att visa.</p>
    }
    else
    {
        <div>
            @foreach (var item in Model)
            {
                <div>
                    <div>@item.Name</div>
                    <div>@item.description</div>
                    <div><img src="@Url.Content("~/" + item.Image)" alt="image of item.name" class="Alster_Size_Img"></div>
                </div>
            }
        </div>

    }
</div>
</body>